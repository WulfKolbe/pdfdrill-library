         <xmp:CreatorTool>Acrobat PDFMaker 11 Word ç‰ˆ</xmp:CreatorTool>
         <xmpMM:DocumentID>uuid:dca43a5e-3c33-4ccb-9b20-860d6c1ab057</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:bb986aa2-2aff-4c11-9a90-921fdbda28dd</xmpMM:InstanceID>
         <xmpMM:subject>
            <rdf:Seq>
               <rdf:li>33</rdf:li>
            </rdf:Seq>
         </xmpMM:subject>
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Including Space-Time in the Extended Group   of Relativistic Form-Invariance</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The inclusion of space-time in the extended group of relativistic form-inva- riance,  , is specified as the inclusion of the whole space-time manifold in this multiplicative Lie group. First physical results presented here are: the geometric origin of the time arrow, a better understanding of the non-simultaneity in optics and a mainly geometric origin for the universe expansion, and its recent acceleration.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Claude Daviau1, Jacques Bertrand</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <pdf:Producer>Adobe PDF Library 11.0</pdf:Producer>
         <pdf:Keywords>Space-Time Manifold, Invariance Group, Standard Model, Acceleration of Expansion</pdf:Keywords>
         <pdfx:SourceModified>D:20220812060138</pdfx:SourceModified>
         <pdfx:Company/>
         <photoshop:headline>
            <rdf:Seq>
               <rdf:li>The inclusion of space-time in the extended group of relativistic form-inva- riance,  , is specified as the inclusion of the whole space-time manifold in this multiplicative Lie group. First physical results presented here are: the geometric origin of the time arrow, a better understanding of the non-simultaneity in optics and a mainly geometric origin for the universe expansion, and its recent acceleration.</rdf:li>
            </rdf:Seq>
         </photoshop:headline>
      </rdf:Description>
   </rdf:RDF>
